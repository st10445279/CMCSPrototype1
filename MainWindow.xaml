<Window x:Class="CMCSPrototype1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CMCSPrototype1.Views"
        Title="Contract Monthly Claim System"
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#ecf0f1">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#2c3e50">
            <StackPanel>
                <TextBlock Text="CMCS" FontSize="28" FontWeight="Bold" Foreground="White" Margin="20,20,0,30"/>

                <Button Content="📝 Submit Claim" Style="{StaticResource NavButtonStyle}" Click="SubmitClaim_Click"/>
                <Button Content="📊 Claim Status" Style="{StaticResource NavButtonStyle}" Click="ClaimStatus_Click"/>
                <Button Content="✅ Verify Claims" Style="{StaticResource NavButtonStyle}" Click="VerifyClaim_Click"/>
                <Button Content="🏆 Approve Claims" Style="{StaticResource NavButtonStyle}" Click="ApproveClaim_Click"/>
                <Button Content="Lecturer Dashboard" Click="LecturerDashboard_Click"/>
                <Button Content="Coordinator Dashboard" Click="CoordinatorDashboard_Click"/>
                <Button Content="Manager Dashboard" Click="ManagerDashboard_Click"/>

            </StackPanel>
        </Border>

        <!-- Content Frame -->
        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
