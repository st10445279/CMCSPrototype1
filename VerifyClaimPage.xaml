<Page x:Class="CMCSPrototype1.Views.SubmitClaimPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Submit Claim"
      Background="#f4f6f9">

    <Grid>
        <Border CornerRadius="15" Background="White" Padding="20" Margin="40">
            <StackPanel>
                <TextBlock Text="Submit Monthly Claim" FontSize="26" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,20"/>
                <TextBlock Text="Select Contract:" FontWeight="SemiBold"/>
                <ComboBox Width="250" Height="35" Margin="0,5,0,15">
                    <ComboBoxItem Content="Contract IT101"/>
                    <ComboBoxItem Content="Contract CS202"/>
                </ComboBox>
                <TextBlock Text="Select Month:" FontWeight="SemiBold"/>
                <DatePicker Width="250" Height="35" Margin="0,5,0,15"/>
                <TextBlock Text="Upload Supporting Documents:" FontWeight="SemiBold"/>
                <Button Content="📎 Choose File..." Width="180" Height="40" Click="ChooseFile_Click"/>
                <Button Content="🚀 Submit Claim" Width="180" Height="45" Margin="0,20,0,0" Click="SubmitClaim_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
