<Page x:Class="CMCSPrototype1.Views.ApproveClaimPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Approve Claims"
      Background="#f4f6f9">

    <Grid>
        <Border CornerRadius="15" Background="White" Padding="20" Margin="40">
            <StackPanel>
                <TextBlock Text="Approve Claims (Academic Manager)" FontSize="26" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,20"/>

                <ListBox Height="200" Margin="0,0,0,15">
                    <ListBoxItem Content="Claim #1 - Lecturer: John Doe"/>
                    <ListBoxItem Content="Claim #2 - Lecturer: Jane Smith"/>
                </ListBox>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="✔ Approve" Width="120" Height="40" Background="#27ae60" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="Approve_Click"/>
                    <Button Content="✖ Reject" Width="120" Height="40" Margin="10,0,0,0" Background="#e74c3c" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="Reject_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
