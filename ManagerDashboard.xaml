<Page x:Class="CMCSPrototype1.Views.ManagerDashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ManagerDashboard" Background="#f4f6f9">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
            <TextBlock Text="Academic Manager Dashboard" 
                       FontSize="26" FontWeight="Bold" Foreground="#2c3e50" 
                       Margin="0,0,0,20"/>

            <Button Content="📝 Approve Claims" Width="220" Height="50" 
                    Background="#27ae60" Foreground="White" FontWeight="Bold"
                    Click="Approve_Click"/>

            <Button Content="📈 View Reports" Width="220" Height="50" 
                    Background="#8e44ad" Foreground="White" FontWeight="Bold"
                    Click="Reports_Click"/>
        </StackPanel>
    </Grid>
</Page>
