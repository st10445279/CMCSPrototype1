<Page x:Class="CMCSPrototype1.Views.ClaimStatusPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#f4f6f9"
      Title="Claim Status">

    <Grid>
        <Border CornerRadius="15" Background="White" Padding="20" Margin="40" Effect="{DynamicResource DropShadow}">
            <StackPanel>
                <TextBlock Text="Claim Status" FontSize="26" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,20"/>
                <TextBlock Text="Claim ID: #12345" FontSize="16"/>
                <TextBlock Text="Status: Submitted" FontSize="16" Foreground="#2980b9"/>
                <TextBlock Text="Progress:" Margin="0,20,0,5"/>
                <ProgressBar Width="250" Height="25" Value="50" Foreground="#27ae60"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
