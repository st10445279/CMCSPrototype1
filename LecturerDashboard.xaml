<Page x:Class="CMCSPrototype1.Views.LecturerDashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="LecturerDashboard" Background="#f4f6f9">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
            <TextBlock Text="Lecturer Dashboard" 
                       FontSize="28" FontWeight="Bold" 
                       Foreground="#2c3e50" Margin="0,0,0,20"/>

            <Button Content="➕ Submit New Claim" Width="220" Height="50" 
                    Background="#3498db" Foreground="White" FontWeight="Bold"
                    Click="SubmitClaim_Click"/>

            <Button Content="📊 View Claim Status" Width="220" Height="50" 
                    Background="#2ecc71" Foreground="White" FontWeight="Bold"
                    Click="ViewStatus_Click"/>
        </StackPanel>
    </Grid>
</Page>
